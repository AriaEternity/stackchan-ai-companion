# Production Nginx vhost for StackChan.
# DNS for stackchan.example.com must point directly to this server.
server {
    listen 80;
    listen [::]:80;
    server_name stackchan.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name stackchan.example.com;
    ssl_certificate /etc/letsencrypt/live/stackchan.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stackchan.example.com/privkey.pem;

    location /ws/device {
        proxy_pass http://127.0.0.1:8787/ws/device;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        if ($args != "") { return 400; }
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-StackChan-Device-ID $http_x_stackchan_device_id;
        proxy_set_header X-StackChan-Protocol $http_x_stackchan_protocol;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        # Device credentials are headers only. This location never writes an access log.
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 90s;
    }
}
