# 使用 Compose 时改为 postgresql+psycopg://stackchan:自己的URL编码密码@postgres:5432/stackchan
POSTGRES_PASSWORD=
REDIS_URL=
STACKCHAN_ADMIN_PASSWORD=
STACKCHAN_AUTH_SECRET=
STACKCHAN_DEVICE_TOKEN=
STACKCHAN_DEVICE_ID=demo-device-001
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
STACKCHAN_MOTION_LOCKED=true
